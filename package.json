{
  "name": "volleyball-fundraiser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "format:check": "prettier --check src server tests scripts netlify/functions *.js package.json",
    "format": "prettier --write src server tests scripts netlify/functions *.js package.json",
    "configure:review": "node scripts/configure-hosted-review.mjs"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.1",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  }
}
